# Where the shop's database lives.
# The scheme selects the psycopg 3 driver, which is what requirements.txt pins.
DATABASE_URL=postgresql+psycopg://shop:shop@localhost:5432/shop

# The database the tests build and tear down. Never point this at real data:
# the test suite drops its schema on every run.
TEST_DATABASE_URL=postgresql+psycopg://shop:shop@localhost:5432/shop_test

FLASK_APP=wsgi.py
FLASK_DEBUG=1

# Set to 1 to log every SQL statement.
SQL_ECHO=0
